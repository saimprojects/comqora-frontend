{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.comqora.com"
        }
      ],
      "destination": "https://comqora.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://comqora.up.railway.app/api/"
    },
    {
      "source": "/admin",
      "destination": "https://comqora.up.railway.app/admin/"
    },
    {
      "source": "/api/:path(.*)",
      "destination": "https://comqora.up.railway.app/api/:path"
    },
    {
      "source": "/admin/:path(.*)",
      "destination": "https://comqora.up.railway.app/admin/:path"
    },
    {
      "source": "/static/:path(.*)",
      "destination": "https://comqora.up.railway.app/static/:path"
    },
    {
      "source": "/:path((?!api(?:/|$)|admin(?:/|$)|static(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/:path(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin/:path(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
